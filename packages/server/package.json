    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bounded/core": "*",
    "@bounded/provider": "*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "better-sqlite3": "^11.7.0"
  }
}
