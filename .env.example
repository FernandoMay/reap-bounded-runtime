# ---------------------------------------------------------------------------
# Bounded Agent Runtime — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored. Never commit
# a populated copy, and never paste these values into a prompt or an issue.
# ---------------------------------------------------------------------------

# --- Reap credentials (REQUIRED for real sandbox mode) ----------------------
# Sent as `Authorization: Bearer <REAP_API_KEY>`. Sandbox keys look like
# `sk_sbx_...`. Obtain yours from the Reap buildathon team — they are sent
# privately per team and are not recoverable from the repo.
REAP_API_KEY=

# --- Reap transport ---------------------------------------------------------
# Base URL of the Reap environment. Documented sandbox hosts:
#   https://sandbox.api.reap.global  (Singapore sandbox, alias)
#   https://sg.sandbox.api.reap.global (Singapore sandbox)
#   https://mx.sandbox.api.reap.global (Mexico sandbox)
# Production hosts (https://prod.api.reap.global, sg./mx.prod.) REJECT the
# X-Simulate-Checkout header. The runtime refuses to send it to production.
REAP_BASE_URL=https://sandbox.api.reap.global

# Pinned API version. The OpenAPI enum currently allows exactly one value.
REAP_VERSION=2025-02-14

# Hard ceiling for every outbound Reap call, in milliseconds. Guards against
# hanging requests when a merchant backend stalls mid-quote.
REAP_TIMEOUT_MS=15000

# --- Runtime mode -----------------------------------------------------------
# `sandbox` = talk to a real Reap sandbox and require a real API key.
# `mock`    = talk to the bundled fixture provider. No network, no key needed.
RUNTIME_MODE=mock

# --- Simulation -------------------------------------------------------------
# X-Simulate-Checkout value, sandbox only. COMPLETED makes the provider settle
# the checkout without a human clicking the hosted approval page. It exists so
# the E2E suite is reproducible on CI. Leave COMPLETED for tests, leave unset
# for the demo so that real human approval is exercised.
REAP_SIMULATE_CHECKOUT=COMPLETED

# --- Server -----------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
# Bearer token that callers must present on every runtime request. The runtime
# has no anonymous mode. Generate with: openssl rand -hex 32
RUNTIME_API_TOKEN=
LOG_LEVEL=info

# --- Persistence ------------------------------------------------------------
DATABASE_PATH=./data/runtime.sqlite

# --- Amount semantics -------------------------------------------------------
# Reap documents monetary amounts as a JSON `number` without stating whether
# those are major units (129.00) or minor units (12900). The documented examples
# are consistent with MAJOR units: a 129 USD headphone price, a 150 USD mandate
# ceiling. Default accordingly, and keep MINOR available so the assumption can be
# flipped without a code change if it is ever disproved.
REAP_AMOUNT_SEMANTICS=MAJOR
